 platform = "A1111"
@@ -65,6 +67,22 @@ except ImportError:
 def read_timeout():
     return 15, getattr(opts, "civsfz_request_timeout", 30)
 
+
+def get_civitai_api_key(runtime_value=None):
+    for candidate in (
+        runtime_value,
+        os.environ.get("CIVITAI_API_KEY"),
+        getattr(opts, "civsfz_api_key", ""),
+    ):
+        if candidate is None:
+            continue
+
+        api_key = str(candidate).strip()
+        if api_key:
+            return api_key[:32]
+
+    return ""
+
 class HTML2txt(HTMLParser):
     text = ""
     prevEndTag = ""
