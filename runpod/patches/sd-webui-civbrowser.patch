+    @staticmethod
+    def _path_in_directory(path: Path, directory: Path) -> bool:
+        try:
+            path_abs = os.path.normcase(os.path.abspath(path))
+            dir_abs = os.path.normcase(os.path.abspath(directory))
+        except OSError:
+            return False
+
+        return path_abs == dir_abs or path_abs.startswith(dir_abs + os.sep)
+
+    def refresh_webui_state(self, file_path: Path):
+        refreshes = []
+
+        with Downloader._refresh_lock:
+            try:
+                if self._path_in_directory(file_path, type_path("Checkpoint")):
+                    from modules import shared
+
+                    shared.refresh_checkpoints()
+                    refreshes.append("checkpoints")
+
+                elif self._path_in_directory(file_path, type_path("VAE")):
+                    from modules import shared_items
+
+                    shared_items.refresh_vae_list()
+                    refreshes.append("vae")
+
+                elif any(
+                    self._path_in_directory(file_path, type_path(model_type))
+                    for model_type in ("LORA", "LoCon", "DoRA")
+                ):
+                    import networks
+
+                    networks.list_available_networks()
+                    refreshes.append("lora")
+
+                elif self._path_in_directory(file_path, type_path("Hypernetwork")):
+                    from modules import shared
+
+                    shared.reload_hypernetworks()
+                    refreshes.append("hypernetworks")
+
+                elif self._path_in_directory(file_path, type_path("TextualInversion")):
+                    from modules.sd_hijack import model_hijack
+
+                    model_hijack.embedding_db.load_textual_inversion_embeddings(force_reload=True)
+                    refreshes.append("embeddings")
+            except Exception as exc:
+                print_ly(f"Refresh failed for {file_path.name}: {exc}")
+
+        if refreshes:
+            print_lc(
+                f"Refreshed WebUI indexes after download: {', '.join(refreshes)}"
+            )
+
